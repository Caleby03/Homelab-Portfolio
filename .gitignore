# ============================================
# Secrets — the only part of this file that matters
# ============================================
.env
.env.*
# Anything ending in .env — data.env, monitoring.env, and Portainer's
# generated stack.env. The two patterns above do NOT cover these: they match
# `.env` and `.env.something`, not `something.env`. Without this line a
# stack.env dropped into the repo would be committed silently.
*.env
!.env.example
*.key
*.pem
*.p12
secrets/
**/credentials.json
**/authentik/media/

# SOPS-encrypted files ARE safe to commit — that's the point.
!*.enc.yaml
!*.enc.env

# ============================================
# Runtime state — belongs in volumes, not git
# ============================================
data/
*.db
*.sqlite
*.sqlite3
prometheus-data/
grafana-data/
paperless-media/
**/backups/

# ============================================
# Generated reports
# ============================================
windows-audit.md
*.log

# ============================================
# OS / editor
# ============================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
